{
  "run_name": "ej3_best",
  "seeds": [0, 1, 2, 3, 4],
  "dataset": {
    "name": "digits_union",
    "format": "digits",
    "path": "datasets/digits_union.csv",
    "normalize": "none",
    "target_encoding": "onehot",
    "n_classes": 10,
    "split": {
      "kind": "holdout",
      "ratio": 0.8,
      "stratified": true
    }
  },
  "model": {
    "layers": [784, 256, 128, 10],
    "hidden_activation": "relu",
    "output_activation": "sigmoid",
    "beta": 1.0,
    "initializer": "he"
  },
  "training": {
    "loss": "mse",
    "optimizer": {
      "kind": "adam",
      "lr": 0.001
    },
    "batch_size": 32,
    "epochs": 300,
    "early_stopping": {
      "patience": 20,
      "monitor": "val_loss",
      "mode": "min",
      "restore_best": true
    },
    "augmentation": {
      "kind": "random_shift",
      "max_px": 1
    }
  },
  "metrics": ["accuracy", "macro_f1"],
  "logging": {
    "every": 10,
    "save_model": true,
    "save_predictions": true
  }
}
