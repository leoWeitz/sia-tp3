{
  "run_name": "ej1_scaling",
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "dataset": {
    "name": "fraud_dataset",
    "path": "datasets/fraud_dataset.csv",
    "target": "big_model_fraud_probability",
    "features": [
      "timestamp",
      "amount_usd",
      "quantity_purchased",
      "session_duration_seconds",
      "days_since_last_purchase",
      "account_age_days",
      "device_screen_resolution",
      "time_since_last_login_s",
      "items_viewed_before_purchase"
    ],
    "drop": [
      "flagged_fraud"
    ],
    "task": "regression",
    "normalize": "zscore",
    "split": {
      "kind": "none"
    }
  },
  "model": {
    "layers": [
      "auto",
      1
    ],
    "output_activation": "sigmoid",
    "beta": 1.0
  },
  "training": {
    "loss": "mse",
    "optimizer": {
      "kind": "gd",
      "lr": 0.1
    },
    "batch_size": null,
    "epochs": 500
  },
  "metrics": [
    "mse",
    "mae"
  ],
  "logging": {
    "every": 100,
    "save_predictions": true,
    "checkpoint_every": 0
  },
  "sweep": {
    "model.output_activation": [
      "identity",
      "sigmoid"
    ],
    "dataset.normalize": [
      "none",
      "minmax",
      "zscore"
    ]
  }
}
