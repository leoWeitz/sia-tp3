{
  "run_name": "ej1_split_strategy",
  "seed": 8,
  "fold": 4,
  "trainer": "backprop",
  "dataset": {
    "name": "fraud_dataset",
    "format": "tabular",
    "path": "datasets/fraud_dataset.csv",
    "synthetic": null,
    "target": "big_model_fraud_probability",
    "features": [
      "timestamp",
      "amount_usd",
      "quantity_purchased",
      "session_duration_seconds",
      "days_since_last_purchase",
      "account_age_days",
      "device_screen_resolution",
      "time_since_last_login_s",
      "items_viewed_before_purchase"
    ],
    "drop": [
      "flagged_fraud"
    ],
    "categorical": [],
    "na_policy": "error",
    "task": "regression",
    "n_classes": null,
    "normalize": "zscore",
    "feature_range": null,
    "target_encoding": "none",
    "target_in_range": null,
    "split": {
      "kind": "kfold",
      "k": 5,
      "stratified": true,
      "seed": null
    },
    "holdout_test": {
      "ratio": 0.2,
      "seed": 0,
      "stratified": true,
      "indices_path": "results/ej1_split/test_idx.npy"
    },
    "test_path": null
  },
  "model": {
    "layers": [
      "auto",
      1
    ],
    "hidden_activation": "tanh",
    "output_activation": "sigmoid",
    "beta": 1.0,
    "initializer": "xavier",
    "init_params": {}
  },
  "training": {
    "loss": "mse",
    "optimizer": {
      "kind": "adam",
      "lr": 0.003
    },
    "batch_size": 32,
    "epochs": 300,
    "l2": 0.0,
    "augmentation": null,
    "early_stopping": {
      "patience": 30,
      "monitor": "val_loss",
      "mode": "min",
      "min_delta": 0.0,
      "restore_best": true
    },
    "adaptive_eta": null
  },
  "metrics": [
    "mse",
    "mae"
  ],
  "logging": {
    "every": 50,
    "save_model": true,
    "save_predictions": true,
    "checkpoint_every": 0,
    "save_weights_history": false
  },
  "sweep": {
    "dataset.split": [
      {
        "kind": "holdout",
        "ratio": 0.8,
        "stratified": false
      },
      {
        "kind": "holdout",
        "ratio": 0.5,
        "stratified": true
      },
      {
        "kind": "holdout",
        "ratio": 0.6,
        "stratified": true
      },
      {
        "kind": "holdout",
        "ratio": 0.7,
        "stratified": true
      },
      {
        "kind": "holdout",
        "ratio": 0.8,
        "stratified": true
      },
      {
        "kind": "holdout",
        "ratio": 0.9,
        "stratified": true
      },
      {
        "kind": "kfold",
        "k": 5,
        "stratified": true
      }
    ]
  },
  "selected_from": null,
  "final": null
}
